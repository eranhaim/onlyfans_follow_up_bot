# Copy to .env and fill in values

# Admin panel login
ADMIN_PASSWORD=change-me

# PostgreSQL (used by docker-compose)
POSTGRES_USER=followup
POSTGRES_PASSWORD=followup
POSTGRES_DB=followup

# App
DATABASE_URL=postgresql+psycopg://followup:followup@postgres:5432/followup
MONGODB_URL=mongodb://mongo:27017/followup
FRONTEND_ORIGIN=http://localhost:8087

# Telegram — get from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: pre-authenticated session string (skip phone login in admin)
# TELEGRAM_SESSION_STRING=

# OpenAI — for AI-generated follow-up messages
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AWS S3 — for video bank storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=followup-videos
AWS_REGION=us-east-1

# Scheduler checks every N seconds
SCHEDULER_INTERVAL_SECONDS=300
